<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<title>Planificación · {{ period_label }}</title>
<style>
  /* Page setup tuned to fit a typical month (~10 slot rows incl.
     team_role splits) on a single landscape A4. With more rows
     WeasyPrint will paginate automatically. Tight but readable —
     bumping any of these breaks single-page fit. */
  @page {
    size: A4 landscape;
    margin: 8mm 8mm 8mm 8mm;
    @bottom-center {
      content: "Trivu · " counter(page) " / " counter(pages);
      font-family: 'DejaVu Sans', sans-serif;
      font-size: 7pt;
      color: #9ca3af;
    }
  }
  body {
    font-family: 'DejaVu Sans', sans-serif;
    color: #1f2937;
    font-size: 7pt;
  }
  .header {
    display: flex;
    align-items: center;
    gap: 6mm;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 2mm;
    margin-bottom: 3mm;
  }
  .header img.logo {
    width: 12mm;
    height: 12mm;
    border-radius: 2.5mm;
    object-fit: cover;
  }
  .header .titles {
    display: flex;
    flex-direction: column;
  }
  .header .h1 {
    font-size: 13pt;
    font-weight: 700;
    color: #111827;
    line-height: 1.1;
  }
  .header .meta {
    font-size: 8pt;
    color: #6b7280;
    margin-top: 0.5mm;
  }
  .header .meta .pill {
    display: inline-block;
    padding: 0.3mm 1.5mm;
    border-radius: 1.2mm;
    background: #f3f4f6;
    color: #374151;
    font-weight: 600;
    margin-left: 1.5mm;
    font-size: 7pt;
  }
  table.grid {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin-bottom: 3mm;
  }
  table.grid th, table.grid td {
    border: 0.3pt solid #e5e7eb;
    padding: 0.6mm 0.8mm;
    vertical-align: top;
    overflow: hidden;
    line-height: 1.15;
  }
  table.grid thead th {
    background: #f9fafb;
    font-weight: 600;
    text-align: center;
    font-size: 6.5pt;
    color: #4b5563;
  }
  table.grid thead th.day-num {
    font-size: 8pt;
    color: #111827;
    padding-bottom: 0;
  }
  table.grid thead th.weekday {
    font-size: 6pt;
    color: #6b7280;
    text-transform: uppercase;
    padding-top: 0;
    padding-bottom: 0.8mm;
  }
  table.grid thead th.is-weekend { color: #9ca3af; }
  table.grid thead th.is-holiday { color: #b45309; }
  table.grid td.slot-cell {
    text-align: left;
    background: #ffffff;
    padding-left: 1.5mm;
    width: 26mm;
  }
  table.grid td.slot-cell .slot-name {
    font-weight: 600;
    font-size: 7pt;
    color: #111827;
  }
  table.grid td.slot-cell .role {
    font-size: 6pt;
    color: #6b7280;
    margin-top: 0.2mm;
  }
  table.grid td.slot-cell .dot {
    display: inline-block;
    width: 1.2mm;
    height: 1.2mm;
    border-radius: 50%;
    margin-right: 0.8mm;
    vertical-align: middle;
  }
  table.grid td.day-cell {
    text-align: left;
    font-size: 6.5pt;
    line-height: 1.1;
  }
  table.grid td.day-cell .person {
    display: block;
    color: #1f2937;
  }
  table.grid td.day-cell .role {
    color: #9ca3af;
    font-size: 5.5pt;
  }
  table.grid td.day-cell.empty {
    color: #d1d5db;
    text-align: center;
  }
  table.grid tr.libre td {
    background: #f0fdf4;
  }
  table.grid tr.libre td.slot-cell {
    background: #ecfdf5;
  }
  table.grid tr.libre td.slot-cell .slot-name {
    color: #065f46;
  }
  table.grid tr.libre td.day-cell {
    color: #064e3b;
  }
  /* Tight gap between the two chunks. WeasyPrint will still break
     to a new page if the second chunk doesn't fit; nothing to do
     manually here. */
  .chunk-spacer {
    height: 2mm;
  }
</style>
</head>
<body>

<div class="header">
  <img class="logo" src="{{ logo_url }}" alt="Trivu" />
  <div class="titles">
    <div class="h1">Planificación · {{ period_label }}</div>
    <div class="meta">
      {{ tenant_name }}
      <span class="pill">{{ status_label }}</span>
      · Generado {{ generated_at }}
    </div>
  </div>
</div>

{% for chunk in chunks %}
<table class="grid">
  <colgroup>
    <col style="width: 30mm" />
    {% for d in chunk.dates %}
    <col />
    {% endfor %}
  </colgroup>
  <thead>
    <tr>
      <th rowspan="2" class="slot-cell">Turno</th>
      {% for d in chunk.dates %}
      <th class="day-num {% if d.is_holiday %}is-holiday{% elif d.is_weekend %}is-weekend{% endif %}">
        {{ d.day }}
      </th>
      {% endfor %}
    </tr>
    <tr>
      {% for d in chunk.dates %}
      <th class="weekday {% if d.is_holiday %}is-holiday{% elif d.is_weekend %}is-weekend{% endif %}">
        {{ d.weekday }}
      </th>
      {% endfor %}
    </tr>
  </thead>
  <tbody>
    {% for row in chunk.rows %}
    <tr>
      <td class="slot-cell">
        {% if row.color %}<span class="dot" style="background: {{ row.color }};"></span>{% endif %}
        <span class="slot-name">{{ row.slot_name }}</span>
        {% if row.team_role_label %}
        <div class="role">{{ row.team_role_label }}</div>
        {% endif %}
      </td>
      {% for cell in row.cells %}
      {% if cell|length == 0 %}
      <td class="day-cell empty">—</td>
      {% else %}
      <td class="day-cell">
        {% for entry in cell %}
        <span class="person">{{ entry.person_name }}</span>
        {% endfor %}
      </td>
      {% endif %}
      {% endfor %}
    </tr>
    {% endfor %}
    {# Libre row — render only if at least one absence falls in this
       chunk's date range. Otherwise we'd be eating a row of vertical
       space for an all-dashes line, which can be the difference
       between fitting one page and spilling. #}
    {% set has_absences = chunk.absences | selectattr("0") | list %}
    {% if has_absences %}
    <tr class="libre">
      <td class="slot-cell">
        <span class="slot-name">Libre</span>
      </td>
      {% for cell in chunk.absences %}
      {% if cell|length == 0 %}
      <td class="day-cell empty">—</td>
      {% else %}
      <td class="day-cell">
        {% for entry in cell %}
        <span class="person">{{ entry.person_name }}</span>
        {% endfor %}
      </td>
      {% endif %}
      {% endfor %}
    </tr>
    {% endif %}
  </tbody>
</table>

{% if not loop.last %}
<div class="chunk-spacer"></div>
{% endif %}
{% endfor %}

</body>
</html>
