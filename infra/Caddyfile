# albus-v2 production reverse proxy.
#
# Path-based tenancy: every customer uses https://trivu.net (single
# domain). The tenant context lives in the JWT. No wildcard DNS, no
# on-demand TLS, no per-tenant subdomains.
#
# Two hosts:
# - trivu.net      → Next.js web app (login, /me, /admin/*, etc.)
# - api.trivu.net  → FastAPI backend
#
# Caddy auto-issues + renews Let's Encrypt certs for both. Make sure DNS
# points both names at the VPS before first deploy or HTTP-01 will fail.

trivu.net {
    encode zstd gzip
    reverse_proxy web:3000
}

api.trivu.net {
    encode zstd gzip
    reverse_proxy api:8000
}
