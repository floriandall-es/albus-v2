# Copy to /srv/albus/.env on the VPS and fill in real secrets.
# Then run docker compose --env-file /srv/albus/.env -f infra/docker-compose.prod.yml up -d --build

POSTGRES_USER=albus
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_STRING
POSTGRES_DB=albus

# Generate with:  openssl rand -hex 48
JWT_SECRET=GENERATE_A_LONG_RANDOM_STRING

# Ops alerting (P1). Unhandled 500s + worker failures email this address
# (throttled). Leave blank to rely on logs only. Needs working SMTP below.
OPS_ALERT_EMAIL=

# Backups (P2 — used by infra/backup.sh, see RUNBOOK.md §4). Prefer an EU
# bucket region (hospital data). Set a lifecycle/retention rule on the bucket.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Region matching the provider's location (Hetzner: fsn1/nbg1/hel1).
# Default us-east-1 works for most S3-compatible providers if unset.
S3_REGION=
# Optional: local staging retention (days) + a healthchecks.io-style
# dead-man's-switch URL pinged on each successful backup.
BACKUP_RETENTION_DAYS=14
BACKUP_PING_URL=
