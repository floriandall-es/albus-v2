# Copy to /srv/albus/.env on the VPS and fill in real secrets.
# Then run docker compose --env-file /srv/albus/.env -f infra/docker-compose.prod.yml up -d --build

POSTGRES_USER=albus
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_STRING
POSTGRES_DB=albus

# Generate with:  openssl rand -hex 48
JWT_SECRET=GENERATE_A_LONG_RANDOM_STRING

# Backups (optional — used by the cron in RUNBOOK.md)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
