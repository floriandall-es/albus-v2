# ============================================================
# albus-v2 — environment template
# ============================================================
# Copy to .env (or for prod, /srv/albus/.env on the VPS) and fill in.
#
# In LOCAL DEV the docker-compose.yml supplies safe defaults so this file
# is mostly a reference. In PROD on the Hetzner VPS, /srv/albus/.env is
# loaded by docker compose --env-file /srv/albus/.env -f infra/docker-compose.prod.yml.

# --- Postgres (the migrations role; runtime uses albus_app) ---
POSTGRES_USER=albus
POSTGRES_PASSWORD=change-me-long-random-string
POSTGRES_DB=albus

# --- API ---
# 32+ bytes of entropy. Generate: openssl rand -hex 48
JWT_SECRET=change-me-openssl-rand-hex-48
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60

# --- SMTP / email (prod) ---
# Resend / Mailgun / Brevo / AWS SES — all work via SMTP relay.
# Set EMAIL_ENABLED=false to log invitation URLs instead of sending.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxx_change_me
SMTP_FROM=Trivu <noreply@trivu.net>
SMTP_USE_TLS=true
EMAIL_ENABLED=true

# --- Web (build-time bake-in for the Next.js client) ---
# Read by the web Dockerfile at build time. The prod compose already
# overrides this; no change needed unless you white-label.
NEXT_PUBLIC_API_BASE_URL=https://api.trivu.net
